# /etc/hire-me-chat/config.env  (optional: every line has a default)
#
# Copy this file there only if you want to change something. systemd reads
# it as root, so keep it root-only (it may hold a webhook URL):
#   sudo chmod 600 /etc/hire-me-chat/config.env
# Restart the service after an edit:  sudo systemctl restart hire-me-chat

# Discord channel for alerts: one address hitting its limit, the whole
# site hitting its limit, or a script calling without the page. At most
# one post per kind per hour. Empty = alerts only in the journal.
# The Preside by Side alerts webhook (LOG_WEBHOOK_URL in
# /etc/preside-by-side/config.env) is a fine place for these.
ALERT_WEBHOOK_URL=

# How long Ollama keeps the model in VRAM after the last question.
# Empty = Ollama's own 5 minutes, after which the next question waits
# about 15 seconds while it loads. 30m or 2h keeps it warm longer and
# keeps 6 GB of the card busy that long.
KEEP_ALIVE=

# Limits (these are the defaults)
IP_MAX=20
IP_WINDOW_SEC=3600
GLOBAL_MAX=200
GLOBAL_WINDOW_SEC=3600
QUEUE_MAX=4
QUEUE_WAIT_SEC=20

# The model and its settings (these are the defaults)
MODEL=llama3
NUM_CTX=8192
NUM_PREDICT=512
TEMPERATURE=0.3
