[Unit]
Description=FEN Status Station - monitoring daemon and dashboard
After=network.target

[Service]
Type=simple
# Runs as the existing `preside` user: it already has read access to the
# suggest service DB dir, which the station opens read-only. The
# systemd-journal supplementary group grants journalctl access for the
# feed tail.
User=preside
Group=preside
SupplementaryGroups=systemd-journal
WorkingDirectory=/var/lib/status-station
Environment=CONFIG_FILE=/etc/status-station/config.env
ExecStart=/usr/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8788 --chdir /var/www/frontendneeded.com/status-station/server station:app
Restart=on-failure
RestartSec=5

# Hardening — read config, read suggest DB, write own DB dir, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/status-station
ReadOnlyPaths=/etc/status-station /var/lib/preside-by-side

[Install]
WantedBy=multi-user.target
