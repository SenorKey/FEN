# Status Station config — copy to /etc/status-station/config.env.
# Every key is optional; the defaults below are what the service uses
# when a key is absent. Uncomment to override.

# Where the dashboard + API listen. Keep on loopback and view via
# `ssh -L 8788:localhost:8788` or RustDesk; set to the LAN IP only if
# you also open the port in firewalld for the LAN zone.
#LISTEN_HOST=127.0.0.1
#LISTEN_PORT=8788

# Probe targets.
#OLLAMA_PROBE_URL=http://127.0.0.1:11434/api/version
#SUGGEST_PROBE_URL=http://127.0.0.1:8787/ratings/washington
# The vhost probe hits loopback with a Host header because the router
# has no NAT loopback — the public hostname is unreachable from the LAN.
#PUBLIC_SITE_URL=https://127.0.0.1/
#PUBLIC_SITE_HOST=frontendneeded.com
#SYSTEMD_UNITS=httpd,ollama,preside-by-side-suggest
#PROBE_INTERVAL_SEC=15

# Journal tail — the unit whose Discord-bound events feed the dashboard.
# Empty string disables the tail thread.
#JOURNAL_UNIT=preside-by-side-suggest

# Databases. SUGGEST_DB_PATH is opened read-only.
#SUGGEST_DB_PATH=/var/lib/preside-by-side/suggestions.db
#EVENTS_DB_PATH=/var/lib/status-station/events.db

# Origins allowed to POST /event (the beacon endpoint).
#ALLOWED_ORIGIN=https://frontendneeded.com,https://www.frontendneeded.com

# Beacon rate ceilings (drops over the cap, never errors).
#EVENT_RATE_MAX=120
#EVENT_RATE_WINDOW_SEC=60
#EVENT_GLOBAL_MAX=1200
#EVENT_GLOBAL_WINDOW_SEC=60
