# Copy this file to /etc/incisor-trading/config.env on the server and fill in
# the real values. The systemd unit points CONFIG_FILE at it. Tighten the
# permissions after writing:
#   sudo chown root:incisor /etc/incisor-trading/config.env
#   sudo chmod 640 /etc/incisor-trading/config.env
#
# Nothing here is required to start the service. Fixture mode is the default
# and never calls upstream, so a fresh checkout runs with no secrets at all.

# fixture (default) serves committed JSON and makes no network calls ever.
# live calls the real provider and is switched on deliberately, rarely, and
# only once a provider's terms clearly permit displaying its data publicly.
# See docs/DATA-PROVIDER.md — as of 2026-08-27 that permission does not exist.
# live also has no fetcher behind it yet: the cached, quota-counted caller is
# T4. Until then the read routes fail closed with a 503 rather than pretending,
# so there is nothing to gain by switching this.
INCISOR_DATA_SOURCE=fixture

# Required ONLY when INCISOR_DATA_SOURCE=live. Never commit a real key: this
# file is the only place it exists, and it never appears in a response or a
# log line.
UPSTREAM_API_KEY=REPLACE_ME

DB_PATH=/var/lib/incisor-trading/incisor.db
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8789
ALLOWED_ORIGIN=https://frontendneeded.com,https://www.frontendneeded.com

# Per-IP rolling window. A dashboard opening several panels at once makes a
# handful of requests per view, so this is set to allow normal browsing and
# stop scripted hammering.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60

# Service-wide rolling window, across every caller. This is the gate that
# actually protects the thing worth protecting: free-tier upstream quota is
# shared and exhaustible, and a crowd behind one CGNAT could each stay under
# the per-IP cap while draining a whole day's calls between them. Exhausting
# the quota would take the page down for everyone, so it is treated as a
# denial-of-service outcome and bounded by a single number.
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_SEC=60
