[Unit]
Description=ToDo Tensor - the owner's list, read by everyone, saved by the owner
After=network.target

[Service]
Type=simple
User=tensor
Group=tensor
WorkingDirectory=/var/lib/todo-tensor
Environment=CONFIG_FILE=/etc/todo-tensor/config.env
# One worker: the wrong-password counts are kept in memory.
ExecStart=/usr/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8789 --chdir /var/www/frontendneeded.com/todo-tensor/server tensor:app
Restart=on-failure
RestartSec=5

# Hardening: the service reads its config and the repo, and writes only its database folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/todo-tensor
ReadOnlyPaths=/etc/todo-tensor

[Install]
WantedBy=multi-user.target
