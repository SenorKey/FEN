# ToDo Tensor service config. Copy to /etc/todo-tensor/config.env on the
# server (root:tensor 0640). The real file is never committed.

# Signs the owner's sign-in cookie. Changing it signs every browser out.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TENSOR_SECRET_KEY=

# The owner password's hash, never the password itself.
# Make one with:  python3 tensor.py hash-password
TENSOR_OWNER_HASH=

# Where the list and its history live.
TENSOR_DB=/var/lib/todo-tensor/tensor.db

# The copy loaded into an empty database on the very first start.
TENSOR_SEED=/var/www/frontendneeded.com/todo-tensor/list.json

# The page's origins (www. is served too); saves and sign-ins from anywhere else are refused.
ALLOWED_ORIGIN=https://frontendneeded.com,https://www.frontendneeded.com

# Optional:
# SESSION_DAYS=30          how long a sign-in lasts
# KEEP_REVISIONS=1000      how many saved versions are kept
# LOGIN_FAILS_PER_IP=5     wrong passwords from one address before it waits
# LOGIN_FAILS_GLOBAL=30    wrong passwords from everyone before everyone waits
# LOGIN_WINDOW_SEC=900     how long the wait is
