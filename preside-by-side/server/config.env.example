# Copy this file to /etc/preside-by-side/config.env on the server and
# fill in the real values. The systemd unit points CONFIG_FILE at it.
# Tighten perms after writing:  sudo chown root:preside ...; sudo chmod 640 ...

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME
DB_PATH=/var/lib/preside-by-side/suggestions.db
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
ALLOWED_ORIGIN=https://frontendneeded.com,https://www.frontendneeded.com

# Per-IP rate limit (rolling window). Defaults: 10 submissions per hour.
# Tune up for events / load-tests, tune down if abuse appears.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SEC=3600
