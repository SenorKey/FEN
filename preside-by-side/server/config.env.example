# Copy this file to /etc/preside-by-side/config.env on the server and
# fill in the real values. The systemd unit points CONFIG_FILE at it.
# Tighten perms after writing:  sudo chown root:preside ...; sudo chmod 640 ...

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME

# Optional second webhook for service alerts (startup/shutdown, global
# rate-limit trips, suggestion-webhook failures, origin-probe alerts,
# unhandled exceptions). Use a DIFFERENT webhook in a DIFFERENT channel
# from the suggestions one so the two can be rotated independently and
# a leak of one doesn't compromise the other. If left blank, Discord
# alerts are silently disabled and journalctl remains the only sink.
LOG_WEBHOOK_URL=

DB_PATH=/var/lib/preside-by-side/suggestions.db
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
ALLOWED_ORIGIN=https://frontendneeded.com,https://www.frontendneeded.com

# Per-IP rate limit (rolling window). Defaults: 10 submissions per hour.
# Tune up for events / load-tests, tune down if abuse appears.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SEC=3600

# Global rate limit (rolling window) — total submissions across all IPs.
# Defends against CGNAT crowds / VPN-pool brigades that would each stay
# under the per-IP cap but flood the Discord channel in aggregate.
# Default: 60 accepted submissions per hour service-wide.
GLOBAL_RATE_LIMIT_MAX=60
GLOBAL_RATE_LIMIT_WINDOW_SEC=3600

# Probe alert — when one IP gets ORIGIN_REJECT_THRESHOLD bad-Origin
# rejections within the window, fire one WARNING (and no more for that
# IP that window) to the alerts channel. Below threshold is uninteresting
# noise; above looks like someone fuzzing the endpoint.
ORIGIN_REJECT_THRESHOLD=20
ORIGIN_REJECT_WINDOW_SEC=3600

# --- Reader severity ratings (/rate + /ratings/<president>) ---------------
#
# HMAC key for hashing client IPs in the ratings table. Generate once with
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# and paste below. If left blank, the service uses a per-process random
# key (logs WARN on startup) — rate limits then reset on every restart.
RATING_IP_HASH_SECRET=

# Three rate-limit gates, in order of who they stop:
#  - Per (bar, IP) write cap: one initial vote + one change-of-mind per
#    24h. The third write inside the window is silently accepted-and-
#    dropped (same response shape as success so probes can't tune).
#  - Per IP daily cap: stops one user carpet-bombing every bar.
#  - Global per-minute cap: mirrors the /suggest GLOBAL_RATE_LIMIT_MAX
#    pattern; defends against CGNAT crowds / VPN-pool brigades.
RATING_BAR_IP_WRITES=2
RATING_BAR_IP_WRITE_WINDOW_SEC=86400
RATING_IP_MAX=40
RATING_IP_WINDOW_SEC=86400
RATING_GLOBAL_MAX=60
RATING_GLOBAL_WINDOW_SEC=60

# Burst quarantine — when a single bar receives more than THRESHOLD votes
# from distinct hashed-IPs within WINDOW seconds, every vote arriving on
# that bar for the next SUPPRESS_SEC is stored with quarantined=1. These
# rows are auditable in the DB but excluded from the average. One Discord
# WARN fires per trigger.
RATING_BURST_THRESHOLD=8
RATING_BURST_WINDOW_SEC=60
RATING_BURST_SUPPRESS_SEC=1800

# Public aggregate endpoint omits any bar with fewer than this many
# non-quarantined votes — keeps n=1 averages off the page.
RATING_MIN_DISPLAY=5

# Stream each accepted rating to the LOG_WEBHOOK_URL alerts channel.
# Default on. Set to 0 to suppress — the notify queue is bounded (200
# records), so a sustained traffic spike could otherwise push genuinely
# urgent alerts (rate-limit trips, exceptions) out of the queue. When
# off, the same one-line event still lands in journalctl so the audit
# trail is unaffected. The on-disk ratings_history table is the
# authoritative record either way.
RATING_LOG_TO_DISCORD=1
